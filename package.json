{
  "name": "greenlit-workspace",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present && node_modules/.bin/tsc --noEmit -p greenlit-site/tsconfig.json",
    "test:packages": "npm run test --workspaces --if-present",
    "test:app": "npm --prefix greenlit-site test",
    "test": "npm run test:packages && npm run test:app",
    "lint": "npm --prefix greenlit-site run lint",
    "design": "node scripts/check-design-system.mjs",
    "verify": "npm run typecheck && npm run lint && npm run design && npm run spec && npm run test",
    "dev": "npm --prefix greenlit-site run dev",
    "spec": "node scripts/spec-coverage.mjs --min 80",
    "coverage": "npm run test:coverage --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5"
  }
}
