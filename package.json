{
  "name": "greenlit-workspace",
  "private": true,
  "workspaces": [
    "packages/*",
    "greenlit-site"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present && node_modules/.bin/tsc --noEmit -p greenlit-site/tsconfig.json",
    "test:packages": "npm run test --workspaces --if-present",
    "test:app": "npm --workspace greenlit-site test",
    "test": "npm run test:packages && npm run test:app",
    "lint": "npm --workspace greenlit-site run lint",
    "design": "node scripts/check-design-system.mjs",
    "verify": "npm run duplicates && npm run typecheck && npm run lint && npm run design && npm run contrast && npm run collisions && npm run spec && npm run test",
    "dev": "npm --workspace greenlit-site run dev",
    "spec": "node scripts/spec-coverage.mjs --min 80",
    "coverage": "npm run test:coverage --workspaces --if-present",
    "vercel-build": "npm --workspace greenlit-site run build",
    "duplicates": "node scripts/check-duplicate-files.mjs",
    "accuracy": "node scripts/extraction-accuracy.mjs",
    "contrast": "node scripts/check-contrast.mjs",
    "collisions": "node scripts/check-css-collisions.mjs"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0"
  }
}
