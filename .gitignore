# Dependencies
node_modules/

# Build output
.next/
dist/
build/


*.tsbuildinfo

# Environment and secrets — never commit these
.env
.env.*
!.env.example

# Editor and OS
.DS_Store
*.swp

# Local agent/tooling state
.claude/settings.local.json
.agents/
.claude/skills/
